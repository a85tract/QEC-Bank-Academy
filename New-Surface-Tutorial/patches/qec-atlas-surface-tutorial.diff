+def _load_lesson(entry_id, catalog=None):
+    if catalog is not None:
+        candidates = [
+            entry.path / "pedagogy" / "lesson.yaml"
+            for entry in catalog.candidates(entry_id)
+        ]
+    else:
+        candidates = [
+            ROOT / "atlas" / entry_id / "pedagogy" / "lesson.yaml",
+            ROOT / "constructions" / entry_id / "pedagogy" / "lesson.yaml",
+        ]
+    path = next((candidate for candidate in candidates if candidate.exists()), None)
+    if path is None:
+        return None
+    lesson = yaml.safe_load(path.read_text())
+    if not isinstance(lesson, dict) or lesson.get("schema") != LESSON_SCHEMA:
+        raise ValueError(f"{path}: lesson schema must be {LESSON_SCHEMA}")
+    if lesson.get("version") != 1 or lesson.get("entry") != entry_id:
+        raise ValueError(f"{path}: lesson entry/version mismatch")
+    for field in ("title", "subtitle"):
+        if not isinstance(lesson.get(field), str) or not lesson[field].strip():
+            raise ValueError(f"{path}: lesson {field} must be non-empty")
+    landing = lesson.get("landing")
+    if not isinstance(landing, dict) or not all(
+        isinstance(landing.get(field), str) and landing[field].strip()
+        for field in (
+            "description",
+            "orienting_prompt",
+            "start_label",
+            "resume_label",
+        )
+    ):
+        raise ValueError(f"{path}: lesson landing is incomplete")
+    sources = lesson.get("sources")
+    if not isinstance(sources, dict) or not sources:
+        raise ValueError(f"{path}: lesson needs governed sources")
+    for source_id, source in sources.items():
+        if not isinstance(source_id, str) or not isinstance(source, dict):
+            raise ValueError(f"{path}: malformed lesson source")
+        if not all(isinstance(source.get(field), str) for field in ("entry", "instance")):
+            raise ValueError(f"{path}: source {source_id} needs entry and instance")
+        origin = source.get("origin")
+        if not isinstance(origin, dict) or origin.get("kind") != "verified":
+            raise ValueError(f"{path}: source {source_id} must be verified")
+        families = source.get("logical_families")
+        if not isinstance(families, dict) or set(families) != {"X", "Z"}:
+            raise ValueError(f"{path}: source {source_id} needs X/Z logical families")
+    chapters = lesson.get("chapters")
+    if not isinstance(chapters, list) or not chapters:
+        raise ValueError(f"{path}: lesson needs chapters")
+    chapter_ids = set()
+    step_ids = set()
+    for chapter in chapters:
+        if not isinstance(chapter, dict) or not all(
+            isinstance(chapter.get(field), str) and chapter[field].strip()
+            for field in ("id", "title", "summary")
+        ):
+            raise ValueError(f"{path}: malformed lesson chapter")
+        if chapter["id"] in chapter_ids:
+            raise ValueError(f"{path}: duplicate chapter id {chapter['id']}")
+        chapter_ids.add(chapter["id"])
+        steps = chapter.get("steps")
+        if not isinstance(steps, list) or not steps:
+            raise ValueError(f"{path}: chapter {chapter['id']} has no steps")
+        for step in steps:
+            if not isinstance(step, dict) or not all(
+                isinstance(step.get(field), str) and step[field].strip()
+                for field in ("id", "title", "panel", "prompt", "explanation")
+            ):
+                raise ValueError(f"{path}: malformed lesson step")
+            if step["id"] in step_ids:
+                raise ValueError(f"{path}: duplicate step id {step['id']}")
+            if step["panel"] not in LESSON_PANELS:
+                raise ValueError(f"{path}: unsupported panel {step['panel']}")
+            if step.get("source", "primary") not in sources:
+                raise ValueError(f"{path}: step {step['id']} has unknown source")
+            origin = step.get("origin")
+            if not isinstance(origin, dict) or origin.get("kind") not in {
+                "verified",
+                "curated",
+            }:
+                raise ValueError(f"{path}: step {step['id']} needs an origin")
+            if origin["kind"] == "curated" and not origin.get("ref"):
+                raise ValueError(f"{path}: curated step {step['id']} needs a ref")
+            step_ids.add(step["id"])
+    checkpoints = lesson.get("checkpoints", {})
+    for checkpoint_id, checkpoint in checkpoints.items():
+        if not isinstance(checkpoint, dict) or not isinstance(checkpoint.get("choices"), list):
+            raise ValueError(f"{path}: malformed checkpoint {checkpoint_id}")
+        answer = checkpoint.get("answer")
+        if type(answer) is not int or not 0 <= answer < len(checkpoint["choices"]):
+            raise ValueError(f"{path}: checkpoint {checkpoint_id} answer is invalid")
+    return lesson
