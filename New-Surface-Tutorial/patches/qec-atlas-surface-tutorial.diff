+def _support_vector(n, support, *, label):
+    if (
+        not isinstance(support, list)
+        or not support
+        or any(type(index) is not int or not 0 <= index < n for index in support)
+        or len(set(support)) != len(support)
+    ):
+        raise ValueError(f"{label}: support is malformed")
+    vector = np.zeros(n, dtype=np.uint8)
+    vector[support] = 1
+    return vector
+
+
+def _validated_logical_families(cm, declared, *, label):
+    if not isinstance(cm, CheckMatrix) or not cm.is_css():
+        raise ValueError(f"{label}: lesson logical families require a CSS CheckMatrix")
+    hx, hz = cm.to_css()
+    result = {}
+    vectors = {}
+    for pauli, rows, opposite in (("X", hx, hz), ("Z", hz, hx)):
+        supports = declared.get(pauli)
+        if not isinstance(supports, list) or len(supports) < 2:
+            raise ValueError(f"{label}: logical {pauli} family is incomplete")
+        family = []
+        family_vectors = []
+        for index, support in enumerate(supports):
+            vector = _support_vector(
+                cm.n,
+                support,
+                label=f"{label} logical {pauli} representative {index}",
+            )
+            if np.any((opposite @ vector) % 2):
+                raise ValueError(f"{label}: logical {pauli} has nonzero syndrome")
+            if gf2.in_rowspace(vector, rows):
+                raise ValueError(f"{label}: declared logical {pauli} is a stabilizer")
+            if family_vectors and not gf2.in_rowspace(vector ^ family_vectors[0], rows):
+                raise ValueError(f"{label}: logical {pauli} representatives are inequivalent")
+            family.append([int(value) for value in sorted(support)])
+            family_vectors.append(vector)
+        result[pauli] = family
+        vectors[pauli] = family_vectors
+    if int(vectors["X"][0] @ vectors["Z"][0]) % 2 != 1:
+        raise ValueError(f"{label}: selected logical X/Z representatives do not anticommute")
+    return result
+
+
+def _instance_claims(instance):
+    return {
+        claim["property"]: claim
+        for claim in instance.get("claims", [])
+        if isinstance(claim, dict) and isinstance(claim.get("property"), str)
+    }
+
+
+def _lesson_source_payload(source_id, spec, catalog):
+    entry = catalog.require(spec["entry"])
+    instance = next(
+        (item for item in entry.instances if item.get("label") == spec["instance"]),
+        None,
+    )
+    if instance is None:
+        raise ValueError(
+            f"lesson source {source_id} names missing instance "
+            f"{spec['entry']}:{spec['instance']}"
+        )
+    built = catalog.build(entry, instance.get("params", {}))
+    cm = built.get("checkmatrix")
+    lattice = built.get("lattice")
+    if not isinstance(cm, CheckMatrix) or not isinstance(lattice, dict):
+        raise ValueError(f"lesson source {source_id} needs checkmatrix and lattice")
+    cm.validate()
+    hx, hz = cm.to_css()
+    claims = _instance_claims(instance)
+    for property_name, computed in (("n", cm.n), ("k", cm.k)):
+        claim = claims.get(property_name, {})
+        recorded = claim.get("value", claim.get("exact"))
+        if recorded != computed:
+            raise ValueError(
+                f"lesson source {source_id} computed {property_name}={computed} "
+                f"but instance records {recorded}"
+            )
+    serialized_schedule = schedule_data(
+        built.get("schedule"),
+        lattice,
+        built.get("geometry"),
+    )
+    scene = built.get("scene") or scene_data(lattice, serialized_schedule)
+    validate_scene(scene)
+    return {
+        "id": source_id,
+        "entry": spec["entry"],
+        "instance": spec["instance"],
+        "label": spec.get("label", spec["instance"]),
+        "geometryScope": spec.get("geometry_scope", "Illustrative coordinates."),
+        "origin": spec["origin"],
+        "params": instance.get("params", {}),
+        "claims": claims,
+        "computed": {
+            "n": {"value": cm.n, "origin": {"kind": "verified", "method": "CheckMatrix.n"}},
+            "k": {"value": cm.k, "origin": {"kind": "verified", "method": "CheckMatrix.k"}},
+        },
+        "lattice": lattice,
+        "scene": scene,
+        "matrixRows": {
+            "X": [[int(q) for q in np.flatnonzero(row)] for row in hx],
+            "Z": [[int(q) for q in np.flatnonzero(row)] for row in hz],
+        },
+        "logicalFamilies": _validated_logical_families(
+            cm,
+            spec["logical_families"],
+            label=f"lesson source {source_id}",
+        ),
+    }
+
+
+def _lesson_circuit_payload(spec, catalog):
+    entry = catalog.require(spec["entry"])
+    instance = next(
+        (item for item in entry.instances if item.get("label") == spec["instance"]),
+        None,
+    )
+    if instance is None:
+        raise ValueError("lesson circuit names a missing instance")
+    built = catalog.build(entry, instance.get("params", {}))
+    source = (entry.path / spec["source"]).resolve()
+    if not source.is_relative_to(entry.path.resolve()) or not source.is_file():
+        raise ValueError("lesson circuit source leaves the entry or is missing")
+    schedule = load_ancilla_memory_schedule(
+        source,
+        built["checkmatrix"],
+        built["lattice"],
+        expected_id=spec["id"],
+        expected_version=spec["version"],
+        expected_entry=spec["entry"],
+        expected_instance=spec["instance"],
+        expected_component=spec["component"],
+    )
+    public_fields = (
+        "schema",
+        "id",
+        "version",
+        "entry",
+        "instance",
+        "component",
+        "data_qubits",
+        "checks",
+        "cnot_layers",
+        "fault_fixtures",
+    )
+    payload = {field: schedule[field] for field in public_fields}
+    payload["artifactSha256"] = schedule["_artifact_sha256"]
+    payload["origin"] = spec["origin"]
+    payload["cnotConventions"] = {
+        "X": {
+            "control": "ancilla",
+            "target": "data",
+            "preparation": "|+>",
+            "measurement": "X basis",
+            "propagationRule": "An X component on the ancilla control propagates to each later data target.",
+            "origin": {"kind": "derived", "method": "CSS ancilla-measurement convention"},
+        },
+        "Z": {
+            "control": "data",
+            "target": "ancilla",
+            "preparation": "|0>",
+            "measurement": "Z basis",
+            "propagationRule": "A Z component on the ancilla target propagates to each later data control.",
+            "origin": {"kind": "derived", "method": "CSS ancilla-measurement convention"},
+        },
+    }
+    checks_by_row = {row["atlas_row"]: row for row in payload["checks"]}
+    for fixture in payload["fault_fixtures"]:
+        fault = fixture["fault"]
+        match = re.fullmatch(r"after-cnot-layer-([1-9][0-9]*)", fault["location"])
+        if match is None:
+            raise ValueError("lesson circuit fixture has an unsupported location")
+        insertion_layer = int(match.group(1))
+        check = checks_by_row[fault["check"]]
+        cumulative = set()
+        trace = []
+        for layer_number, layer in enumerate(payload["cnot_layers"], start=1):
+            if layer_number <= insertion_layer:
+                continue
+            additions = sorted(
+                edge["data"] for edge in layer
+                if edge["check"] == fault["check"]
+            )
+            cumulative.update(additions)
+            trace.append({
+                "layer": layer_number,
+                "newData": additions,
+                "cumulativeData": sorted(cumulative),
+            })
+        if sorted(cumulative) != fixture["propagated_data"]["atlas_indices"]:
+            raise ValueError(f"lesson circuit fixture {fixture['id']} trace mismatch")
+        fixture["insertionLayer"] = insertion_layer
+        fixture["checkIdentity"] = {
+            "row": check["atlas_row"],
+            "type": check["type"],
+            "ancilla": check["ancilla"],
+            "support": check["support"],
+        }
+        fixture["trace"] = trace
+    return payload
+
+
+def _lesson_surgery_payload(spec):
+    parity = set()
+    for check in spec.get("checks", []):
+        if not isinstance(check, dict) or set(check) != {"id", "support"}:
+            raise ValueError("lesson surgery check is malformed")
+        for symbol in check["support"]:
+            if not isinstance(symbol, str) or not symbol:
+                raise ValueError("lesson surgery support symbol is malformed")
+            if symbol in parity:
+                parity.remove(symbol)
+            else:
+                parity.add(symbol)
+    target = spec.get("target")
+    if not isinstance(target, list) or parity != set(target):
+        raise ValueError("lesson surgery seam product does not equal its target")
+    construction = spec.get("merged_construction", {})
+    if (
+        not isinstance(construction, dict)
+        or construction.get("schema") != "qec-atlas-lesson-construction-v1"
+        or construction.get("op") != "hgp"
+    ):
+        raise ValueError("lesson surgery needs a typed HGP merged construction")
+    inputs = construction.get("inputs")
+    if not isinstance(inputs, dict) or set(inputs) != {"H1", "H2"}:
+        raise ValueError("lesson surgery HGP inputs are malformed")
+    factors = []
+    for input_id in ("H1", "H2"):
+        factor = inputs[input_id]
+        if not isinstance(factor, dict) or factor.get("generator") != "rep_parity":
+            raise ValueError("lesson surgery supports only declared rep_parity factors")
+        length = factor.get("length")
+        if type(length) is not int or length < 2:
+            raise ValueError("lesson surgery repetition length is invalid")
+        factors.append(length)
+    first, second = factors
+    hx, hz = hgp(rep_parity(first), rep_parity(second))
+    cm = CheckMatrix.from_css(hx, hz)
+    cm.validate()
+    distance, method = exact_distance(cm, w_max=min(first, second))
+    return {
+        "label": spec["label"],
+        "observable": spec["observable"],
+        "scope": spec["scope"],
+        "origin": spec["origin"],
+        "symbolLegend": spec["symbol_legend"],
+        "checks": spec["checks"],
+        "target": sorted(target),
+        "mergedConstruction": construction,
+        "mergedProduct": {
+            "firstRepetitionLength": first,
+            "secondRepetitionLength": second,
+            "n": {"value": cm.n, "origin": {"kind": "verified", "method": "HGP matrix width"}},
+            "k": {"value": cm.k, "origin": {"kind": "verified", "method": "CheckMatrix.k"}},
+            "d": {"exact": distance, "origin": {"kind": "verified", "method": method}},
+        },
+    }
+
+
+def _lesson_construction_payload(sources):
+    source = sources.get("primary") or next(iter(sources.values()))
+    length = source.get("params", {}).get("L")
+    if type(length) is not int or length < 2:
+        raise ValueError("lesson construction primer needs an integer repetition length")
+    repetition = rep_parity(length)
+    repetition_rows = [
+        [int(index) for index in np.flatnonzero(row)]
+        for row in repetition
+    ]
+    n = len(source["lattice"]["coords"])
+    hx = np.zeros((len(source["matrixRows"]["X"]), n), dtype=np.uint8)
+    hz = np.zeros((len(source["matrixRows"]["Z"]), n), dtype=np.uint8)
+    for matrix, rows in ((hx, source["matrixRows"]["X"]), (hz, source["matrixRows"]["Z"])):
+        for row_index, support in enumerate(rows):
+            matrix[row_index, support] = 1
+    nonzero_commutators = int(np.count_nonzero((hx @ hz.T) % 2))
+    if nonzero_commutators != 0:
+        raise ValueError("lesson construction primer found noncommuting CSS rows")
+    bit_bit = length * length
+    check_check = (length - 1) * (length - 1)
+    if bit_bit + check_check != n:
+        raise ValueError("lesson construction primer block sizes do not match source n")
+    verified = {"kind": "verified", "method": "rep_parity + constructor CheckMatrix"}
+    return {
+        "factorNames": {
+            "A": "first open repetition-chain copy",
+            "B": "second open repetition-chain copy",
+        },
+        "length": {"value": length, "origin": verified},
+        "repetitionRows": repetition_rows,
+        "repetitionOrigin": verified,
+        "qubitBlocks": {
+            "bitByBit": {"value": bit_bit, "origin": verified},
+            "checkByCheck": {"value": check_check, "origin": verified},
+            "total": {"value": n, "origin": verified},
+        },
+        "commutation": {
+            "equation": "H_X H_Z^T = 0 over GF(2)",
+            "nonzeroEntries": {"value": nonzero_commutators, "origin": verified},
+        },
+    }
+
+
+def _lesson_payload(lesson, entries_by_id, catalog):
+    sources = {
+        source_id: _lesson_source_payload(source_id, spec, catalog)
+        for source_id, spec in lesson["sources"].items()
+    }
+    tour_spec = lesson["advanced_tour"]
+    tour = _load_tour(tour_spec["entry"], catalog=catalog)
+    if tour is None:
+        raise ValueError("lesson advanced tour is missing")
+    advanced_tour = _tour_payload(tour, entries_by_id, catalog=catalog)
+    advanced_tour["label"] = tour_spec["label"]
+    advanced_tour["href"] = f"../tours/{tour_spec['entry']}.html"
+    for lattice in advanced_tour["lattices"].values():
+        entry = catalog.require(lattice["entry"])
+        instance = next(
+            item for item in entry.instances
+            if item.get("label") == lattice.get("instance")
+        )
+        lattice["claims"] = _instance_claims(instance)
+    entry_data = entries_by_id[lesson["entry"]]
+    return {
+        "lesson": lesson,
+        "sources": sources,
+        "constructionPrimer": _lesson_construction_payload(sources),
+        "advancedTour": advanced_tour,
+        "circuit": _lesson_circuit_payload(lesson["circuit"], catalog),
+        "surgery": _lesson_surgery_payload(lesson["surgery"]),
+        "referenceLedger": {
