+:root {
+  --learn-navy: #102a36;
+  --learn-teal: #0e6675;
+  --learn-teal-soft: #e6f4f5;
+  --learn-gold: #9a6700;
+  --learn-gold-soft: #fff5d6;
+  --learn-red: #a62036;
+  --learn-green: #087f5b;
+  --learn-purple: #6d28d9;
+}
+
+.learn-body {
+  max-width: none;
+  padding: 0 2rem 4rem;
+  background: #f4f7f8;
+}
+
+.learn-shell {
+  width: min(1480px, 100%);
+  min-width: 0;
+  margin: 0 auto;
+}
+
+.learn-header {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 2rem;
+  border-bottom: 1px solid #cbd7dc;
+  padding: 2rem 0 1.4rem;
+}
+
+.learn-header h1 {
+  margin: .2rem 0 .35rem;
+  font-size: clamp(2rem, 4vw, 3.4rem);
+}
+
+.learn-header p:last-child {
+  max-width: 780px;
+  margin: 0;
+  color: var(--muted);
+}
+
+.learn-header-actions {
+  display: flex;
+  flex: 0 0 auto;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: .7rem;
+}
+
+.learn-layout {
+  display: grid;
+  grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
+  min-width: 0;
+  gap: 1.4rem;
+  padding-top: 1.4rem;
+}
+
+.learn-navigation {
+  min-width: 0;
+  align-self: start;
+  position: sticky;
+  top: 1rem;
+  max-height: calc(100vh - 2rem);
+  overflow-y: auto;
+  border: 1px solid #cbd7dc;
+  border-radius: 16px;
+  padding: 1rem;
+  background: #fff;
+}
+
+.learn-navigation ol {
+  display: grid;
+  gap: .45rem;
+  margin: 1rem 0 0;
+  padding: 0;
+  min-width: 0;
+  list-style: none;
+}
+
+.learn-navigation button {
+  display: grid;
+  width: 100%;
+  gap: .22rem;
+  border: 1px solid transparent;
+  border-radius: 10px;
+  padding: .65rem .7rem;
+  color: #33444d;
+  text-align: left;
+}
+
+.learn-navigation button span { font-weight: 720; }
+.learn-navigation button small { color: var(--muted); line-height: 1.32; }
+.learn-navigation button[aria-current="step"] {
+  border-color: #9fc4cd;
+  background: var(--learn-teal-soft);
+  color: var(--learn-navy);
+}
+
+.learn-navigation button.chapter-complete span::after {
+  content: " ✓";
+  color: var(--learn-green);
+}
+
+.learn-progress > span {
+  color: var(--muted);
+  font-size: .82rem;
+}
+
+.learn-progress [role="progressbar"] {
+  height: .45rem;
+  margin-top: .35rem;
+  overflow: hidden;
+  border-radius: 999px;
+  background: #e7ecef;
+}
+
+.learn-progress [role="progressbar"] span {
+  display: block;
+  width: 0;
+  height: 100%;
+  background: var(--learn-teal);
+}
+
+.learn-workbench {
+  min-width: 0;
+  border: 1px solid #cbd7dc;
+  border-radius: 18px;
+  padding: clamp(1.1rem, 2.5vw, 2rem);
+  background: #fff;
+  box-shadow: 0 14px 38px rgba(16, 42, 54, .07);
+}
+
+.learn-notice {
+  margin: 0 0 1rem;
+  border-left: 4px solid var(--learn-gold);
+  border-radius: 6px;
+  padding: .7rem .85rem;
+  background: var(--learn-gold-soft);
+  color: #654b10;
+}
+
+.learn-step-header { max-width: 880px; }
+.learn-step-header h2 {
+  margin: .25rem 0 .55rem;
+  font-size: clamp(1.65rem, 3vw, 2.35rem);
