+.learn-controls { display: grid; gap: .8rem; }
+.learn-canvas-column,
+.learn-controls,
+.learn-control-section { min-width: 0; }
+.learn-control-section,
+.learn-capstone-card {
+  margin: 0;
+  border: 1px solid #d5dfe3;
+  border-radius: 12px;
+  padding: .85rem;
+  background: #fcfdfd;
+}
+.learn-control-section h3,
+.learn-capstone-card legend { margin: 0 0 .35rem; font-size: .96rem; font-weight: 760; }
+.learn-control-section h4,
+.learn-capstone-card h4 { margin: 0 0 .3rem; font-size: .88rem; }
+.learn-control-note { margin: 0 0 .65rem; color: var(--muted); font-size: .84rem; }
+.learn-question { margin-top: 0; font-weight: 650; }
+
+.learn-inline-question {
+  margin: .7rem 0 0;
+  border: 1px dashed #b7c8ce;
+  border-radius: 9px;
+  padding: .65rem;
+}
+.learn-inline-question legend { padding: 0 .3rem; font-size: .86rem; font-weight: 700; }
+
+.learn-evidence-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
+  gap: .55rem;
+  margin: .65rem 0;
+}
+.learn-evidence-card {
+  min-width: 0;
+  border-left: 3px solid #8fb3bc;
+  border-radius: 7px;
+  padding: .6rem .7rem;
+  background: #f2f7f8;
+}
+.learn-evidence-card p { margin: 0; overflow-wrap: anywhere; font-size: .8rem; line-height: 1.4; }
+.learn-evidence-card small { display: block; margin-top: .38rem; color: var(--muted); overflow-wrap: anywhere; }
+
+.learn-bridge,
+.learn-verifier-details {
+  margin-top: .65rem;
+  border: 1px solid #cbd8dd;
+  border-radius: 8px;
+  padding: .55rem .65rem;
+  background: #fff;
+}
+.learn-bridge summary,
+.learn-verifier-details summary { cursor: pointer; color: var(--learn-teal); font-weight: 700; }
+.learn-bridge-list,
+.learn-symbol-list,
+.learn-trace-list { margin: .55rem 0 0; padding-left: 1.2rem; }
+.learn-bridge-list li,
+.learn-symbol-list li,
+.learn-trace-list li { margin: .3rem 0; color: #42515a; font-size: .82rem; line-height: 1.4; }
+.learn-circuit-conventions { margin-top: .7rem; border-top: 1px solid #dce4e7; padding-top: .55rem; }
+
+.learn-button-grid {
+  display: flex;
+  flex-wrap: wrap;
+  gap: .42rem;
+  margin: .55rem 0;
+}
+.learn-qubit-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(3.4rem, 1fr)); }
+.learn-check-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(4rem, 1fr)); }
+.learn-button-grid button { white-space: normal; }
+.learn-button-grid button[aria-pressed="true"] {
+  border-color: var(--learn-teal);
+  background: var(--learn-teal-soft);
+  color: var(--learn-navy);
+}
+.learn-choice-button { width: 100%; border-radius: 9px; padding: .55rem .65rem; text-align: left; }
+.learn-primary-button {
+  border-color: var(--learn-teal);
+  background: var(--learn-teal);
+  color: #fff;
+  font-weight: 720;
+}
+.learn-primary-button:hover { background: #084f5b; color: #fff; }
+
+.learn-edge-list {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
+  gap: .3rem .8rem;
+  margin: .6rem 0 0;
+  padding-left: 1.2rem;
+  color: #42515a;
+  font-family: ui-monospace, monospace;
+  font-size: .79rem;
+}
+
+.learn-equation-box,
+.learn-parameter-line,
+.learn-ledger-line {
+  overflow-wrap: anywhere;
+  border-radius: 8px;
+  padding: .65rem .72rem;
+  background: #eef3f5;
+  font-family: ui-monospace, monospace;
+  font-size: .84rem;
+}
+
+.learn-inline-link { display: inline-block; margin-top: .5rem; }
+.learn-capstone-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
+.learn-capstone-response {
+  width: 100%;
+  resize: vertical;
+  border: 1px solid #aebdc3;
+  border-radius: 10px;
+  padding: .75rem;
+  font: inherit;
+  line-height: 1.5;
+}
+.learn-capstone-response:focus-visible { outline: 3px solid #75b9c9; outline-offset: 2px; }
+
+.learn-legend {
+  display: flex;
+  flex-wrap: wrap;
+  gap: .55rem 1rem;
+  margin-top: .65rem;
+  color: var(--muted);
+  font-size: .8rem;
+}
+.learn-legend-item { display: inline-flex; align-items: center; gap: .38rem; }
+.learn-legend-symbol { display: inline-block; width: .85rem; height: .85rem; border: 2px solid #5f6b76; }
+.learn-legend-symbol.mark-error { transform: rotate(45deg); border-color: var(--learn-red); background: rgba(166, 32, 54, .12); }
+.learn-legend-symbol.mark-recovery { border-color: var(--learn-green); background: rgba(8, 127, 91, .12); }
+.learn-legend-symbol.mark-cancelled { border-radius: 50%; border-color: #5f6b76; background: linear-gradient(135deg, transparent 43%, #5f6b76 45%, #5f6b76 55%, transparent 57%); }
+.learn-legend-symbol.mark-logical { border: 3px double var(--learn-purple); border-radius: 50%; }
+.learn-legend-symbol.mark-check { width: 1.1rem; height: .65rem; border-color: #2563a8; border-radius: 999px; }
+
+.learn-explanation {
+  margin-top: 1rem;
+  border: 1px solid #d5dfe3;
+  border-radius: 10px;
+  padding: .72rem .85rem;
+  background: #fafcfc;
+}
+.learn-explanation summary { cursor: pointer; color: var(--learn-teal); font-weight: 720; }
+.learn-explanation p { margin-bottom: .35rem; }
+.learn-origin { color: var(--muted); font-family: ui-monospace, monospace; font-size: .78rem; }
+.learn-reference { margin: .9rem 0 0; }
+
+.learn-step-actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  gap: .7rem;
+  margin-top: 1.3rem;
+  border-top: 1px solid #dce4e7;
+  padding-top: 1rem;
+}
+
+@media (max-width: 980px) {
+  .learn-body { padding: 0 1rem 3rem; }
+  .learn-header { align-items: flex-start; flex-direction: column; }
+  .learn-layout { grid-template-columns: minmax(0, 1fr); }
+  .learn-navigation { position: static; max-height: none; overflow: visible; }
+  .learn-navigation ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .learn-stage-grid { grid-template-columns: minmax(0, 1fr); }
+}
+
+@media (max-width: 580px) {
+  .learn-body { padding-inline: .55rem; }
+  .learn-header { padding-top: 1.2rem; }
+  .learn-header-actions { width: 100%; }
+  .learn-layout { gap: .75rem; padding-top: .75rem; }
+  .learn-navigation,
+  .learn-workbench { border-radius: 12px; }
+  .learn-navigation { padding: .7rem; }
+  .learn-navigation ol {
+    display: flex;
+    width: 100%;
+    max-width: 100%;
+    overflow-x: auto;
+    scroll-snap-type: x proximity;
+  }
+  .learn-navigation li { flex: 0 0 min(78vw, 18rem); scroll-snap-align: start; }
+  .learn-workbench { padding: .9rem; }
+  .learn-capstone-grid { grid-template-columns: 1fr; }
+  .learn-scene-toolbar small { width: 100%; margin-left: 0; }
+  .learn-step-actions button { flex: 1 1 8rem; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
+}
