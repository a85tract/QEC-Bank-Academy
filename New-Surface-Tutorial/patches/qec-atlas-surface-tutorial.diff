+.learn-step-header > p:last-child { color: #3e4c55; font-size: 1.06rem; }
+
+.learn-stage-grid {
+  display: grid;
+  grid-template-columns: minmax(360px, 1.22fr) minmax(290px, .78fr);
+  gap: 1.2rem;
+  align-items: start;
+  min-width: 0;
+  margin-top: 1.25rem;
+}
+
+.learn-stage-grid.learn-stage-text-only { grid-template-columns: minmax(0, 1fr); }
