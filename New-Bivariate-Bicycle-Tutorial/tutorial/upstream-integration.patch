+def _tour_formal_payload(
+    checkmatrix,
+    *,
+    derive_logicals=False,
+    derive_two_block_candidates=False,
+):
+    if checkmatrix is None or not checkmatrix.is_css():
+        return None
+    hx, hz = checkmatrix.to_css()
+    formal = {
+        "n": checkmatrix.n,
+        "k": checkmatrix.k,
+        "ranks": {"X": gf2.rank(hx), "Z": gf2.rank(hz)},
+        "xChecks": [
+            [int(index) for index in row.nonzero()[0]]
+            for row in hx
+        ],
+        "zChecks": [
+            [int(index) for index in row.nonzero()[0]]
+            for row in hz
+        ],
+        "logicalPairs": [],
+        "origin": {
+            "kind": "verified",
+            "method": "CheckMatrix.to_css + qeclib.gf2.rank",
+        },
+    }
+    if derive_logicals:
+        for pair_index, (logical_x, logical_z) in enumerate(logical_basis(checkmatrix)):
+            pair = {"id": pair_index}
+            for key, pauli in (("x", logical_x), ("z", logical_z)):
+                vector = pauli.symplectic()
+                pair[key] = {
+                    "xSupport": [
+                        index for index, value in enumerate(vector[: checkmatrix.n])
+                        if int(value)
+                    ],
+                    "zSupport": [
+                        index for index, value in enumerate(vector[checkmatrix.n :])
+                        if int(value)
+                    ],
+                }
+            formal["logicalPairs"].append(pair)
+        formal["logicalOrigin"] = {
+            "kind": "verified",
+            "method": "qeclib.logicals.logical_basis",
+        }
+    if derive_two_block_candidates:
+        block_size = checkmatrix.n // 2
+        if checkmatrix.n % 2 or hx.shape != (block_size, 2 * block_size):
+            raise ValueError(
+                "two-block commutation candidates require an r × 2r CSS X matrix"
+            )
+        unswapped = []
+        for row in range(block_size):
+            support = [
+                column
+                for column in range(block_size)
+                if int(hx[column, row])
+            ]
+            support.extend(
+                block_size + column
+                for column in range(block_size)
+                if int(hx[column, block_size + row])
+            )
+            unswapped.append(support)
+        formal["twoBlockCandidates"] = {
+            "swappedZChecks": formal["zChecks"],
+            "unswappedZChecks": unswapped,
+            "origin": {
+                "kind": "verified",
+                "method": "transpose each H_X column block; compare swapped order",
+            },
+        }
+    return formal
